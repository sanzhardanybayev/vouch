{
  "name": "vouch-review-coverage",
  "displayName": "Vouch - Review Coverage",
  "description": "Human-authored review coverage: attest code you reviewed; attestations auto-dismiss when the code changes.",
  "version": "0.1.2",
  "publisher": "sanzhardanybayev",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sanzhardanybayev/vouch"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "vouch.init",
        "title": "Vouch: Initialize in workspace"
      },
      {
        "command": "vouch.selection",
        "title": "Vouch: Review selected lines"
      },
      {
        "command": "vouch.function",
        "title": "Vouch: Review enclosing function"
      },
      {
        "command": "vouch.class",
        "title": "Vouch: Review enclosing class"
      },
      {
        "command": "vouch.struct",
        "title": "Vouch: Review enclosing struct"
      },
      {
        "command": "vouch.enum",
        "title": "Vouch: Review enclosing enum"
      },
      {
        "command": "vouch.trait",
        "title": "Vouch: Review enclosing trait"
      },
      {
        "command": "vouch.impl",
        "title": "Vouch: Review enclosing impl"
      },
      {
        "command": "vouch.mod",
        "title": "Vouch: Review enclosing mod"
      },
      {
        "command": "vouch.macro",
        "title": "Vouch: Review enclosing macro"
      },
      {
        "command": "vouch.file",
        "title": "Vouch: Review entire file"
      },
      {
        "command": "vouch.reReview",
        "title": "Vouch: Re-review (after dismissal)"
      },
      {
        "command": "vouch.unvouch",
        "title": "Vouch: Revoke my review"
      },
      {
        "command": "vouch.showDiff",
        "title": "Vouch: Diff since my review"
      },
      {
        "command": "vouch.openCommitOnWeb",
        "title": "Vouch: Open review commit on web"
      },
      {
        "command": "vouch.openTimeline",
        "title": "Vouch: Open review timeline"
      },
      {
        "command": "vouch.reattach",
        "title": "Vouch: Re-attach orphaned reviews"
      },
      {
        "command": "vouch.refresh",
        "title": "Vouch: Refresh reviews and coverage"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "vouch.menu",
          "group": "1_modification@9"
        }
      ],
      "vouch.menu": [
        {
          "command": "vouch.selection",
          "group": "a@1"
        },
        {
          "command": "vouch.function",
          "group": "a@2"
        },
        {
          "command": "vouch.class",
          "group": "a@3"
        },
        {
          "command": "vouch.file",
          "group": "a@4"
        },
        {
          "command": "vouch.struct",
          "when": "editorLangId == rust",
          "group": "ar@1"
        },
        {
          "command": "vouch.enum",
          "when": "editorLangId == rust",
          "group": "ar@2"
        },
        {
          "command": "vouch.trait",
          "when": "editorLangId == rust",
          "group": "ar@3"
        },
        {
          "command": "vouch.impl",
          "when": "editorLangId == rust",
          "group": "ar@4"
        },
        {
          "command": "vouch.mod",
          "when": "editorLangId == rust",
          "group": "ar@5"
        },
        {
          "command": "vouch.macro",
          "when": "editorLangId == rust",
          "group": "ar@6"
        },
        {
          "command": "vouch.reReview",
          "group": "b@1"
        },
        {
          "command": "vouch.unvouch",
          "group": "b@2"
        },
        {
          "command": "vouch.showDiff",
          "group": "c@1"
        }
      ],
      "commandPalette": [
        {
          "command": "vouch.struct",
          "when": "editorLangId == rust"
        },
        {
          "command": "vouch.enum",
          "when": "editorLangId == rust"
        },
        {
          "command": "vouch.trait",
          "when": "editorLangId == rust"
        },
        {
          "command": "vouch.impl",
          "when": "editorLangId == rust"
        },
        {
          "command": "vouch.mod",
          "when": "editorLangId == rust"
        },
        {
          "command": "vouch.macro",
          "when": "editorLangId == rust"
        }
      ]
    },
    "submenus": [
      {
        "id": "vouch.menu",
        "label": "Vouch"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vouch",
          "title": "Vouch",
          "icon": "media/reviewed.svg"
        }
      ]
    },
    "views": {
      "vouch": [
        {
          "id": "vouch.coverage",
          "name": "Review Coverage"
        }
      ]
    },
    "configuration": {
      "title": "Vouch",
      "properties": {
        "vouch.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a CodeLens above reviewed code with reviewer, time, and links to the timeline / re-review / diff."
        },
        "vouch.decorations.style": {
          "type": "string",
          "enum": [
            "bars",
            "gutterIcons"
          ],
          "default": "gutterIcons",
          "enumItemLabels": [
            "Range bars",
            "Gutter icons (deprecated)"
          ],
          "markdownEnumDescriptions": [
            "A thin colored bar along the whole reviewed span, at the right edge of the gutter next to the line numbers. You see how far each review reaches, and a breakpoint dot on the same line stays visible. Hover the code for the review, its links and **Actions…** (re-review, resolve, revoke). Becomes the default in the next major version.",
            "**Deprecated** - removed in the next major version. One icon on the first line of each review only, so the span is invisible; the icon fills the gutter cell where breakpoints are set, so an icon and a breakpoint on the same line cover each other."
          ],
          "markdownDescription": "How reviews are drawn in the editor gutter. `gutterIcons` stays the default until the next major version, which switches to `bars` and removes `gutterIcons`."
        },
        "vouch.coverage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Scan tracked files to compute the sidebar coverage tree and percentages. When off, the sidebar still shows reviewers and orphaned reviews; gutter, hover, and CodeLens are unaffected. The scan only ever runs in repositories containing a .vouch/ folder."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "npm run build && tsc -p tsconfig.int.json && node out-int/test/vscode-int/runTest.js",
    "lint": "eslint src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "eslint": "^10.7.0",
    "glob": "^10.3.0",
    "mocha": "^10.3.0",
    "prettier": "^3.9.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^1.4.0"
  }
}
